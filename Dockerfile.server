# Dockerfile.server — builds the Fastify API (server.js)
FROM node:22-alpine

WORKDIR /app

# Install dependencies first (better layer caching — only re-runs if
# package.json actually changes, not on every code edit)
COPY package.json package-lock.json ./
RUN npm install --omit=dev

# Now copy the actual application code
COPY server.js ./

EXPOSE 3000

CMD ["node", "server.js"]
